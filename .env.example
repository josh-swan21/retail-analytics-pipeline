# Copy this file to .env and replace the placeholder with your private local path.
RETAIL_DATA_DIR="/path/to/local/shopify/exports"

# Snowflake connection (key-pair auth). Copy to .env and fill in your real values.
SNOWFLAKE_ACCOUNT="your_account_identifier"
SNOWFLAKE_USER="your_username"
SNOWFLAKE_PRIVATE_KEY_PATH="/path/to/rsa_key.p8"
# Only needed if you generated your key WITHOUT -nocrypt (i.e. it has a passphrase).
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=""
SNOWFLAKE_ROLE="SYSADMIN"
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"
SNOWFLAKE_DATABASE="RETAIL_DB"
SNOWFLAKE_SCHEMA="CORE"
